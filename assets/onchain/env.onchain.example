# Target chain for the frontend: 8453 (Base, default) or 31337 (local anvil, adds a test-account connector).
NEXT_PUBLIC_CHAIN_ID=
# Optional Base RPC for the browser; defaults to the public https://mainnet.base.org.
NEXT_PUBLIC_BASE_RPC_URL=
# Deploy-time only, never committed or exposed: RPC and a funded deployer key for non-local chains.
RPC_URL=
DEPLOYER_PRIVATE_KEY=
